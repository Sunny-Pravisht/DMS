# Copy this file to .env. Never commit real credentials.
#
# Model NAMES live in config/models.json - edit that file to change models.
# API KEYS and deployment-specific values live here.
#
# Precedence (lowest -> highest):
#   code defaults  <  config/models.json  <  this .env  <  database settings table
# After editing config/models.json on an existing install, run:
#   python cli.py sync-model-config

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ---------------------------------------------------------------------------
# Database and storage
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/documents.db
DATA_FOLDER=./data
STAGING_FOLDER=./data/staging
STORAGE_FOLDER=./data/storage
LOGS_FOLDER=./data/logs
BACKUP_FOLDER=./data/backups

# ---------------------------------------------------------------------------
# AI provider and models
# The provider and all model names live in config/models.json.
# Uncomment anything here only to override that file.
# ---------------------------------------------------------------------------
#AI_PROVIDER=groq
#CHAT_MODEL=openai/gpt-oss-120b
#ANALYSIS_MODEL=openai/gpt-oss-120b
#VISION_MODEL=qwen/qwen3.6-27b
#REASONING_EFFORT=medium

# --- Groq (default provider) -----------------------------------------------
# Get a key at https://console.groq.com/keys
#
# This file is an EXAMPLE and is meant to be shared, so it must never carry a
# real key. It did: a working key was published here in plain text. If that key
# has ever left this machine, revoke it in the Groq console and issue a new one.
GROQ_API_KEY=gsk_your_key_here

# A second key, on a DIFFERENT Groq account. The free tier caps requests per
# minute and tokens per day; when the first key is refused for quota the system
# continues on this one instead of every AI feature stopping at once. Optional -
# leave it blank and behaviour is unchanged.
GROQ_API_KEY_2=

GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI (only if AI_PROVIDER=openai, or for hosted embeddings) ---------
OPENAI_API_KEY=

# --- Azure OpenAI (only if AI_PROVIDER=azure) ------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Embeddings and OCR
# Both are configured in config/models.json ("embeddings" / "ocr" sections).
# Groq has NO embeddings endpoint, so the default runs all-MiniLM-L6-v2 on the
# CPU (384 dims, no API key).
# Changing the backend changes the vector size:
#   python cli.py reindex-vectors --force
# Uncomment below only to override the config file.
# ---------------------------------------------------------------------------
#EMBEDDING_PROVIDER=local
#LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
#EMBEDDING_MODEL=text-embedding-3-small
#OCR_ENGINE=auto
#VISION_OCR_ENABLED=true
#VISION_MAX_PAGES=20
#PDF_TEXT_LAYER_FIRST=true

# Local OCR tools (Tesseract fallback; poppler rasterises scanned PDFs)
TESSERACT_PATH=/usr/bin/tesseract
POPPLER_PATH=/usr/bin

# ---------------------------------------------------------------------------
# File processing
# ---------------------------------------------------------------------------
MAX_FILE_SIZE=100MB
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp,txt,text,md,markdown

# ---------------------------------------------------------------------------
# ChromaDB. The localhost defaults use the embedded persistent client.
# ---------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=documents

# ---------------------------------------------------------------------------
# Runtime behavior
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
AI_TEXT_LIMIT=16000
AI_CONTEXT_LIMIT=10000
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
